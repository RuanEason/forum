# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL="mysql://root:password@127.0.0.1:3306/forum"

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# Set both SITE_URL and NEXTAUTH_URL to your public forum origin in production.
SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Optional explicit deployment environment. Use `staging` for a pre-release
# deployment that is built with NODE_ENV=production.
# APP_ENV="staging"
DEV_TOOLBOX_ENABLED="false"

# Optional. Some deployments may inject this automatically.
VERCEL_URL=""

# ------------------------------------------------------------------
# Tencent COS / CDN
# ------------------------------------------------------------------
TENCENT_COS_SECRET_ID=""
TENCENT_COS_SECRET_KEY=""
TENCENT_COS_BUCKET="your-bucket-1250000000"
TENCENT_COS_REGION="ap-guangzhou"
NEXT_PUBLIC_CDN_DOMAIN="https://cdn.example.com"
TENCENT_ATTACHMENT_PREFIX="attachments/"
TENCENT_ATTACHMENT_MAX_SIZE_BYTES="1073741824"
# Internal health and scheduled-task credentials. Keep these values private.
HEALTHCHECK_SECRET="replace-with-a-long-random-healthcheck-secret"
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Test-only services. Never point these at production resources.
TEST_DATABASE_URL="mysql://root:password@127.0.0.1:3307/forum_test"
TEST_REDIS_URL="redis://127.0.0.1:6380"

# Staged rollout switches. All switches are disabled until their node is verified.
FEATURE_PERMISSION_DB_AUTHORIZATION="false"
FEATURE_CURSOR_PAGINATION="false"
FEATURE_MEDIA_CLEANUP="false"

# Media cleanup worker tuning. The worker is report-only until the feature flag is enabled.
MEDIA_CLEANUP_BATCH_SIZE="50"
MEDIA_CLEANUP_STALE_UPLOAD_HOURS="24"
MEDIA_CLEANUP_STALE_DRAFT_DAYS="30"
COS_ORPHAN_AUDIT_PREFIXES="images/,attachments/,videos/,backgrounds/,editor-pool/,emoji/"

# ------------------------------------------------------------------
# Video upload / STS / workflow callback
# If not set, TENCENT_SECRET_ID / TENCENT_SECRET_KEY will fall back to
# TENCENT_COS_SECRET_ID / TENCENT_COS_SECRET_KEY in code.
# ------------------------------------------------------------------
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
TENCENT_VIDEO_RAW_PREFIX="videos/raw/"
TENCENT_BACKGROUND_VIDEO_RAW_PREFIX="backgrounds/"
TENCENT_STS_DURATION_SECONDS="1800"
TENCENT_VIDEO_MAX_SIZE_BYTES="2147483648"
TENCENT_CI_CALLBACK_TOKEN="replace-with-video-callback-token"

# ------------------------------------------------------------------
# Tencent Push Notification Service (optional)
# Set TPNS_ENABLED to false if you do not use mobile push.
# ------------------------------------------------------------------
TPNS_ENABLED="false"
TPNS_ACCESS_ID=""
TPNS_ACCESS_KEY=""
TPNS_IOS_ENV="product"
TPNS_MAX_RETRY="3"
TPNS_ANDROID_CHANNEL_ID=""
TPNS_API_HOST="api.tpns.tencent.com"

# Optional Expo/App-side readable TPNS values
EXPO_PUBLIC_TPNS_ACCESS_ID=""
EXPO_PUBLIC_TPNS_ACCESS_KEY=""

# ------------------------------------------------------------------
# Redis (optional)
# ------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ------------------------------------------------------------------
# Mail / SMTP (用于邮箱验证码)
# QQ邮箱示例:
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your@qq.com"
# SMTP_PASS="qq-mail-auth-code"
# MAIL_FROM="Slept论坛 <your@qq.com>"
# MAIL_BRAND_NAME="SLEPT"
# MAIL_LOGO_URL="https://your-cdn-domain/logo.png"
# ------------------------------------------------------------------
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
MAIL_BRAND_NAME="SLEPT"
MAIL_LOGO_URL=""
