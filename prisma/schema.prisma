// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  githubUserId String?       @unique
  wechatOpenId String?       @unique
  wechatUnionId String?      @unique
  password     String?
  name         String?
  role         String        @default("user") // user or admin
  banned       Boolean       @default(false)
  sessionVersion Int         @default(0)
  deletionRequestedAt DateTime?
  deletionScheduledAt DateTime?
  avatar       String?
  wechatNickname String?
  wechatAvatar String?
  wechatLastAuthAt DateTime?
  bio          String?
  postViewMode String        @default("both") // title, content, both
  coverImage   String?
  notifyReplies Boolean      @default(true)
  notifyLikes   Boolean      @default(true)
  notifyFollows Boolean      @default(true)
  showUserData Boolean       @default(true) // 是否展示用户数据（帖子数、评论数、粉丝数等）
  experience   Int           @default(0)
  lastLoginRewardAt DateTime?
  dailyLikeRewardCount Int   @default(0)
  lastLikeRewardAt DateTime?
  posts        Post[]
  videoAssets  VideoAsset[]
  createdTopics Topic[]      @relation("TopicCreator")
  topics       Topic[]       @relation("TopicFollows")
  comments     Comment[]
  reposts      Repost[]
  shareEvents  ShareEvent[]
  postLikes    PostLike[]
  commentLikes CommentLike[]
  sentNotifications     Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationReceiver")
  pushDevices           PushDevice[]
  following    Follow[]     @relation("UserFollowing")
  followers    Follow[]     @relation("UserFollowers")
  danmakus     Danmaku[]
  drafts       PostDraft[]
  postEditHistory PostEditHistory[] @relation("PostEditHistoryEditor")
  editorImageBytesUsed Int               @default(0)
  editorImageAssets    EditorImageAsset[]
  mediaCleanupTasks    MediaCleanupTask[] @relation("MediaCleanupTaskOwner")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum PostType {
  TEXT
  VIDEO
}

enum PostVisibility {
  PUBLIC
  UNLISTED
}

enum ContentFormat {
  RICH_TEXT
  PLAIN_TEXT
}

enum VideoStatus {
  INIT
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum DraftPersistMode {
  EPHEMERAL
  SAVED
}

enum DraftStatus {
  EDITING
  UPLOADING
  PROCESSING
  FAILED
  READY
  PUBLISHED
}

enum DraftAssetType {
  IMAGE
  ATTACHMENT
  VIDEO
  COVER
}

enum DraftAssetStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum EditorImageAssetStatus {
  PENDING
  READY
}

enum PostDeletionReason {
  POST_REQUEST
  ACCOUNT_REQUEST
}

enum MediaCleanupResourceType {
  POST_IMAGE
  POST_ATTACHMENT
  VIDEO_RAW
  VIDEO_HLS
  VIDEO_COVER
  BACKGROUND_VIDEO_RAW
  BACKGROUND_VIDEO_COVER
  USER_AVATAR
  USER_COVER
  DRAFT_ASSET
  EDITOR_IMAGE
  ORPHAN
}

enum MediaCleanupReason {
  POST_DELETE
  ACCOUNT_DELETE
  UPLOAD_EXPIRED
  MANUAL
}

enum MediaCleanupStatus {
  PENDING
  PROCESSING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DanmakuType {
  SCROLL
}

model Post {
  id          String           @id @default(cuid())
  title       String?
  content     String           @db.MediumText
  contentJson Json?
  contentFormat ContentFormat  @default(PLAIN_TEXT)
  styleConfig Json?
  styleCss    String?          @db.Text
  postType    PostType         @default(TEXT)
  visibility  PostVisibility   @default(PUBLIC)
  videoId     String?          @unique
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  video       VideoAsset?      @relation(fields: [videoId], references: [id], onDelete: SetNull)
  comments    Comment[]
  reposts     Repost[]
  shareEvents ShareEvent[]
  likes       PostLike[]
  danmakus    Danmaku[]
  images      PostImage[]
  attachments PostAttachment[]
  notifications Notification[]
  editHistory PostEditHistory[]
  draft       PostDraft?       @relation("PublishedPostDraft")
  topicId     String?
  topic       Topic?           @relation(fields: [topicId], references: [id])
  viewCount   Int              @default(0)
  pinned      Boolean          @default(false)
  pinnedAt    DateTime?
  isAnnouncement Boolean       @default(false)
  announcementAt DateTime?
  deletedAt   DateTime?
  deleteScheduledAt DateTime?
  deletionReason PostDeletionReason?
  mediaCleanupTasks MediaCleanupTask[] @relation("MediaCleanupTaskPost")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
  @@index([topicId])
  @@index([pinned, pinnedAt])
  @@index([visibility, deletedAt, pinned, pinnedAt, createdAt, id], map: "Post_feed_page_idx")
  @@index([topicId, visibility, deletedAt, pinned, pinnedAt, createdAt, id], map: "Post_topic_feed_idx")
  @@index([isAnnouncement, announcementAt])
  @@index([deletedAt, deleteScheduledAt])
}

model MediaCleanupTask {
  id           String                   @id @default(cuid())
  dedupeKey    String                   @unique @db.Char(64)
  objectKey    String                   @db.VarChar(1024)
  resourceType MediaCleanupResourceType
  reason       MediaCleanupReason       @default(MANUAL)
  ownerId      String?
  owner        User?                    @relation("MediaCleanupTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  postId       String?
  post         Post?                    @relation("MediaCleanupTaskPost", fields: [postId], references: [id], onDelete: SetNull)
  status       MediaCleanupStatus       @default(PENDING)
  executeAfter DateTime                 @default(now())
  retryCount   Int                      @default(0)
  maxRetries   Int                      @default(5)
  lastError    String?                  @db.Text
  lockedAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, executeAfter])
  @@index([ownerId, status])
  @@index([postId, status])
  @@index([resourceType, status])
  @@index([reason, status])
}

model PostEditHistory {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  editorId   String?
  editor     User?    @relation("PostEditHistoryEditor", fields: [editorId], references: [id], onDelete: SetNull)
  editorName String
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
  @@index([editorId])
}

model Danmaku {
  id        String      @id @default(cuid())
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonId    String?
  content   String      @db.VarChar(200)
  timeMs    Int
  type      DanmakuType @default(SCROLL)
  color     String      @default("#FFFFFF")
  fontSize  Int         @default(24)
  createdAt DateTime    @default(now())

  @@index([postId, timeMs])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([anonId, createdAt])
}

model VideoAsset {
  id                 String      @id @default(cuid())
  ownerId            String
  owner              User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post               Post?
  draftAssets        DraftAsset[]

  bucket             String
  region             String
  rawObjectKey       String      @unique
  rawUrl             String
  mimeType           String
  fileSize           BigInt

  hlsMasterObjectKey String?
  hlsMasterUrl       String?
  coverObjectKey     String?
  coverUrl           String?

  durationSec        Float?
  width              Int?
  height             Int?
  bitrateKbps        Int?

  workflowRunId      String?
  status             VideoStatus @default(INIT)
  errorCode          String?
  errorMessage       String?     @db.Text

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([ownerId, status])
  @@index([createdAt])
}

model PostDraft {
  id              String           @id @default(cuid())
  authorId        String
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postType        PostType         @default(TEXT)
  title           String?
  content         String           @db.MediumText
  contentJson     Json?
  contentFormat   ContentFormat    @default(PLAIN_TEXT)
  styleConfig     Json?
  styleCss        String?          @db.Text
  visibility      PostVisibility   @default(PUBLIC)
  isAnnouncement  Boolean          @default(false)
  topicId         String?
  topic           Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  persistMode     DraftPersistMode @default(EPHEMERAL)
  status          DraftStatus      @default(EDITING)
  lastError       String?          @db.Text
  publishedPostId String?          @unique
  publishedPost   Post?            @relation("PublishedPostDraft", fields: [publishedPostId], references: [id], onDelete: SetNull)
  assets          DraftAsset[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([authorId, persistMode, updatedAt])
  @@index([authorId, status, updatedAt])
}

model DraftAsset {
  id           String           @id @default(cuid())
  draftId      String
  draft        PostDraft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  type         DraftAssetType
  status       DraftAssetStatus @default(PENDING)
  progress     Int              @default(0)
  url          String?
  objectKey    String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  videoAssetId String?
  videoAsset   VideoAsset?      @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  errorMessage String?          @db.Text
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([draftId, status, type])
  @@index([videoAssetId])
}

model EditorImageAsset {
  id        String                 @id
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectKey String                 @unique
  url       String
  fileName  String
  fileSize  Int
  mimeType  String
  status    EditorImageAssetStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([userId, status, createdAt])
}

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  posts       Post[]
  drafts      PostDraft[]
  creatorId   String?
  creator     User?    @relation("TopicCreator", fields: [creatorId], references: [id])
  followers   User[]   @relation("TopicFollows")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PostImage {
  id        String   @id @default(cuid())
  url       String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PostAttachment {
  id            String   @id @default(cuid())
  url           String
  fileName      String
  fileSize      Int
  mimeType      String
  downloadCount Int      @default(0)
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Comment {
  id        String        @id @default(cuid())
  content   String        @db.Text
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?       // for replies
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  replyToId String?
  replyTo   Comment?      @relation("CommentReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replyTargets Comment[]  @relation("CommentReplyTo")
  likes     CommentLike[]
  pinned    Boolean       @default(false)
  pinnedAt  DateTime?
  createdAt DateTime      @default(now())

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([replyToId])
  @@index([pinned, pinnedAt])
  @@index([postId, parentId, pinned, pinnedAt, createdAt, id], map: "Comment_page_idx")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

enum NotificationType {
  REPLY_POST
  REPLY_COMMENT
  LIKE_POST
  LIKE_COMMENT
  FOLLOW_USER
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  isRead    Boolean          @default(false)
  senderId  String
  sender    User             @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver  User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  pushLogs  PushLog[]
  createdAt DateTime         @default(now())

  @@index([receiverId])
  @@index([receiverId, isRead, createdAt])
  @@index([receiverId, createdAt, id], map: "Notification_page_idx")
  @@index([senderId, receiverId, type, postId, isRead])
  @@index([senderId, receiverId, type, commentId, isRead])
}

enum PushPlatform {
  IOS
  ANDROID
  HARMONY
  OTHER
}

enum PushLogStatus {
  PENDING
  RETRYING
  SENT
  FAILED
  SKIPPED
}

model PushDevice {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationId String       @unique
  platform       PushPlatform
  appPackage     String
  appVersion     String?
  isActive       Boolean      @default(true)
  lastSeenAt     DateTime     @default(now())
  pushLogs       PushLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, isActive])
  @@index([platform])
  @@map("push_devices")
}

model PushLog {
  id             String        @id @default(cuid())
  notificationId String
  notification   Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceId       String
  device         PushDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  registrationId String
  requestId      String?
  status         PushLogStatus @default(PENDING)
  attemptCount   Int           @default(0)
  error          String?       @db.Text
  sentAt         DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([notificationId, registrationId])
  @@index([status, nextRetryAt])
  @@index([deviceId])
  @@index([notificationId])
  @@map("push_logs")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model Repost {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model ShareEvent {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel     String   @db.VarChar(32)
  shareSource String   @db.VarChar(64)
  vdSource    String   @db.VarChar(64)
  shareUrl    String   @db.Text
  userAgent   String?  @db.Text
  referer     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([vdSource, createdAt])
  @@map("share_events")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([followerId, createdAt, id], map: "Follow_follower_page_idx")
  @@index([followingId, createdAt, id], map: "Follow_following_page_idx")
}
