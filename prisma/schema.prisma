// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String?
  role         String        @default("user") // user or admin
  banned       Boolean       @default(false)
  avatar       String?
  bio          String?
  postViewMode String        @default("both") // title, content, both
  coverImage   String?
  showUserData Boolean       @default(true) // 是否展示用户数据（帖子数、评论数、粉丝数等）
  experience   Int           @default(0)
  lastLoginRewardAt DateTime?
  dailyLikeRewardCount Int   @default(0)
  lastLikeRewardAt DateTime?
  posts        Post[]
  videoAssets  VideoAsset[]
  createdTopics Topic[]      @relation("TopicCreator")
  topics       Topic[]       @relation("TopicFollows")
  comments     Comment[]
  reposts      Repost[]
  shareEvents  ShareEvent[]
  postLikes    PostLike[]
  commentLikes CommentLike[]
  sentNotifications     Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationReceiver")
  pushDevices           PushDevice[]
  following    Follow[]     @relation("UserFollowing")
  followers    Follow[]     @relation("UserFollowers")
  danmakus     Danmaku[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum PostType {
  TEXT
  VIDEO
}

enum PostVisibility {
  PUBLIC
  UNLISTED
}

enum VideoStatus {
  INIT
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum DanmakuType {
  SCROLL
}

model Post {
  id          String           @id @default(cuid())
  title       String?
  content     String           @db.Text
  postType    PostType         @default(TEXT)
  visibility  PostVisibility   @default(PUBLIC)
  videoId     String?          @unique
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  video       VideoAsset?      @relation(fields: [videoId], references: [id], onDelete: SetNull)
  comments    Comment[]
  reposts     Repost[]
  shareEvents ShareEvent[]
  likes       PostLike[]
  danmakus    Danmaku[]
  images      PostImage[]
  attachments PostAttachment[]
  notifications Notification[]
  topicId     String?
  topic       Topic?           @relation(fields: [topicId], references: [id])
  viewCount   Int              @default(0)
  pinned      Boolean          @default(false)
  pinnedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
  @@index([topicId])
  @@index([pinned, pinnedAt])
}

model Danmaku {
  id        String      @id @default(cuid())
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonId    String?
  content   String      @db.VarChar(200)
  timeMs    Int
  type      DanmakuType @default(SCROLL)
  color     String      @default("#FFFFFF")
  fontSize  Int         @default(24)
  createdAt DateTime    @default(now())

  @@index([postId, timeMs])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([anonId, createdAt])
}

model VideoAsset {
  id                 String      @id @default(cuid())
  ownerId            String
  owner              User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post               Post?

  bucket             String
  region             String
  rawObjectKey       String      @unique
  rawUrl             String
  mimeType           String
  fileSize           BigInt

  hlsMasterObjectKey String?
  hlsMasterUrl       String?
  coverObjectKey     String?
  coverUrl           String?

  durationSec        Float?
  width              Int?
  height             Int?
  bitrateKbps        Int?

  workflowRunId      String?
  status             VideoStatus @default(INIT)
  errorCode          String?
  errorMessage       String?     @db.Text

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([ownerId, status])
  @@index([createdAt])
}

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  posts       Post[]
  creatorId   String?
  creator     User?    @relation("TopicCreator", fields: [creatorId], references: [id])
  followers   User[]   @relation("TopicFollows")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PostImage {
  id        String   @id @default(cuid())
  url       String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PostAttachment {
  id            String   @id @default(cuid())
  url           String
  fileName      String
  fileSize      Int
  mimeType      String
  downloadCount Int      @default(0)
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Comment {
  id        String        @id @default(cuid())
  content   String        @db.Text
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?       // for replies
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  replyToId String?
  replyTo   Comment?      @relation("CommentReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replyTargets Comment[]  @relation("CommentReplyTo")
  likes     CommentLike[]
  pinned    Boolean       @default(false)
  pinnedAt  DateTime?
  createdAt DateTime      @default(now())

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([replyToId])
  @@index([pinned, pinnedAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

enum NotificationType {
  REPLY_POST
  REPLY_COMMENT
  LIKE_POST
  LIKE_COMMENT
  FOLLOW_USER
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  isRead    Boolean          @default(false)
  senderId  String
  sender    User             @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver  User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  pushLogs  PushLog[]
  createdAt DateTime         @default(now())

  @@index([receiverId])
  @@index([receiverId, isRead, createdAt])
  @@index([senderId, receiverId, type, postId, isRead])
  @@index([senderId, receiverId, type, commentId, isRead])
}

enum PushPlatform {
  IOS
  ANDROID
  HARMONY
  OTHER
}

enum PushLogStatus {
  PENDING
  RETRYING
  SENT
  FAILED
  SKIPPED
}

model PushDevice {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationId String       @unique
  platform       PushPlatform
  appPackage     String
  appVersion     String?
  isActive       Boolean      @default(true)
  lastSeenAt     DateTime     @default(now())
  pushLogs       PushLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, isActive])
  @@index([platform])
  @@map("push_devices")
}

model PushLog {
  id             String        @id @default(cuid())
  notificationId String
  notification   Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceId       String
  device         PushDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  registrationId String
  requestId      String?
  status         PushLogStatus @default(PENDING)
  attemptCount   Int           @default(0)
  error          String?       @db.Text
  sentAt         DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([notificationId, registrationId])
  @@index([status, nextRetryAt])
  @@index([deviceId])
  @@index([notificationId])
  @@map("push_logs")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model Repost {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model ShareEvent {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel     String   @db.VarChar(32)
  shareSource String   @db.VarChar(64)
  vdSource    String   @db.VarChar(64)
  shareUrl    String   @db.Text
  userAgent   String?  @db.Text
  referer     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([vdSource, createdAt])
  @@map("share_events")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
